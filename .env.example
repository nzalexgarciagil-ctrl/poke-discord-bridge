# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional safety check. If set, only messages from this guild are bridged.
DISCORD_GUILD_ID=

# Required: Discord channel or DM ID to bridge. Threads require a guild text/news channel.
DISCORD_CHANNEL_ID=

# Telegram API credentials from https://my.telegram.org.
# Existing repo root .env values are loaded automatically if bot/.env is absent.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Run `pnpm login` once, then paste the printed value here.
# Or run `pnpm convert-telethon-session` to convert ../telegram-poke-bridge.session
# and leave TELEGRAM_STRING_SESSION empty.
TELEGRAM_STRING_SESSION=
TELEGRAM_STRING_SESSION_FILE=./data/telegram-string-session.txt

# Poke target. Username defaults to interaction_poke_bot because MTProto numeric user IDs
# often cannot resolve unless the access hash is already cached.
TELEGRAM_TARGET_BOT_ID=8509073799
TELEGRAM_TARGET_BOT_USERNAME=interaction_poke_bot

BRIDGE_DB_PATH=./data/bridge.sqlite
BRIDGE_TMP_DIR=./data/tmp

# Adds a one-time Discord user context block before a user's first bridged message.
LOG_LEVEL=info
